# CoolStatus reads COOLSTATUS_* variables. SQLite is the default.
# Postgres is selected only when a postgres URL is set.

COOLSTATUS_ENV=development
COOLSTATUS_BIND=127.0.0.1
COOLSTATUS_PORT=43123
COOLSTATUS_PUBLIC_ORIGIN=http://127.0.0.1:43123
COOLSTATUS_DATABASE_PATH=data/coolstatus.sqlite

# Uncomment to use Postgres instead of the SQLite file. DATABASE_URL is also accepted.
# COOLSTATUS_DATABASE_URL=postgres://coolstatus:coolstatus@127.0.0.1:5432/coolstatus

# After the first account exists, production closes sign-up unless this is true.
# COOLSTATUS_OPEN_SIGNUP=false

# Optional email delivery. Without it, email channels are recorded as skipped.
# COOLSTATUS_SMTP_HOST=smtp.example.com
# COOLSTATUS_SMTP_PORT=587
# COOLSTATUS_SMTP_USERNAME=
# COOLSTATUS_SMTP_PASSWORD=
# COOLSTATUS_SMTP_FROM=status@example.com
