# Status reads STATUS_* variables. SQLite is the default.
# Postgres is selected only when a postgres URL is set.

STATUS_ENV=development
STATUS_BIND=127.0.0.1
STATUS_PORT=43123
STATUS_PUBLIC_ORIGIN=http://127.0.0.1:43123
STATUS_DATABASE_PATH=data/status.sqlite

# Uncomment to use Postgres instead of the SQLite file. DATABASE_URL is also accepted.
# STATUS_DATABASE_URL=postgres://status:status@127.0.0.1:5432/status

# After the first account exists, production closes sign-up unless this is true.
# STATUS_OPEN_SIGNUP=false

# Optional email delivery. Without it, email channels are recorded as skipped.
# STATUS_SMTP_HOST=smtp.example.com
# STATUS_SMTP_PORT=587
# STATUS_SMTP_USERNAME=
# STATUS_SMTP_PASSWORD=
# STATUS_SMTP_FROM=status@example.com
