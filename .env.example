# Glimwatch reads GLIMWATCH_* variables. When a GLIMWATCH_* name is unset, STATUS_* is
# accepted.
# SQLite is the default. Postgres is selected only when a postgres URL is set.

GLIMWATCH_ENV=development
GLIMWATCH_BIND=127.0.0.1
GLIMWATCH_PORT=43123
GLIMWATCH_PUBLIC_ORIGIN=http://127.0.0.1:43123
GLIMWATCH_DATABASE_PATH=data/glimwatch.sqlite

# Uncomment to use Postgres instead of the SQLite file.
# STATUS_DATABASE_URL and DATABASE_URL are also accepted.
# GLIMWATCH_DATABASE_URL=postgres://glimwatch:glimwatch@127.0.0.1:5432/glimwatch

# Public sign-up stays closed after the setup URL creates the root user.
# The root user opens it in Settings. GLIMWATCH_OPEN_SIGNUP and STATUS_OPEN_SIGNUP
# are ignored.
# A mail server (below, or saved in Settings) is required before registration can open.

# Optional email delivery. Without it, email channels are recorded as skipped.
# These variables also count as the mail server for the registration switch.
# STATUS_SMTP_* is accepted when GLIMWATCH_SMTP_* is unset.
# GLIMWATCH_SMTP_HOST=smtp.example.com
# GLIMWATCH_SMTP_PORT=587
# GLIMWATCH_SMTP_USERNAME=
# GLIMWATCH_SMTP_PASSWORD=
# GLIMWATCH_SMTP_FROM=status@example.com

# Before a failed connection counts against a monitor, Glimwatch checks that it can
# reach one of these host:port targets. Use internal hosts if there is no
# internet access, or "off" to turn the check off.
# GLIMWATCH_CONNECTIVITY_TARGETS=1.1.1.1:443,8.8.8.8:443,9.9.9.9:443

# Trusted proxies in front of analytics collection. 2 also trusts Cloudflare geo headers.
# GLIMWATCH_PROXY_HOPS=0
# Optional MaxMind or DB-IP city database for country, region, and city.
# GLIMWATCH_GEOIP_PATH=/var/lib/glimwatch/dbip-city.mmdb
