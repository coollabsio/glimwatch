# Haruvo reads HARUVO_* variables. The previous STATUS_* names still work.
# SQLite is the default. Postgres is selected only when a postgres URL is set.

HARUVO_ENV=development
HARUVO_BIND=127.0.0.1
HARUVO_PORT=43123
HARUVO_PUBLIC_ORIGIN=http://127.0.0.1:43123
HARUVO_DATABASE_PATH=data/haruvo.sqlite

# Uncomment to use Postgres instead of the SQLite file.
# DATABASE_URL and STATUS_DATABASE_URL are also accepted.
# HARUVO_DATABASE_URL=postgres://haruvo:haruvo@127.0.0.1:5432/haruvo

# Public sign-up stays closed after the setup URL creates the root user.
# The root user opens it in Settings. HARUVO_OPEN_SIGNUP is ignored.
# A mail server (below, or saved in Settings) is required before registration can open.

# Optional email delivery. Without it, email channels are recorded as skipped.
# These variables also count as the mail server for the registration switch.
# HARUVO_SMTP_HOST=smtp.example.com
# HARUVO_SMTP_PORT=587
# HARUVO_SMTP_USERNAME=
# HARUVO_SMTP_PASSWORD=
# HARUVO_SMTP_FROM=status@example.com

# Before a failed connection counts against a monitor, Haruvo checks that it can
# reach one of these host:port targets. Use internal hosts if there is no
# internet access, or "off" to turn the check off.
# HARUVO_CONNECTIVITY_TARGETS=1.1.1.1:443,8.8.8.8:443,9.9.9.9:443

# Trusted proxies in front of analytics collection. 2 also trusts Cloudflare geo headers.
# HARUVO_PROXY_HOPS=0
# Optional MaxMind or DB-IP city database for country, region, and city.
# HARUVO_GEOIP_PATH=/var/lib/haruvo/dbip-city.mmdb
