# Owlee reads OWLEE_* variables.
# SQLite is the default. Postgres is selected only when OWLEE_DATABASE_URL is set.

OWLEE_ENV=development
OWLEE_BIND=127.0.0.1
OWLEE_PORT=43123
OWLEE_PUBLIC_ORIGIN=http://127.0.0.1:43123
OWLEE_DATABASE_PATH=data/owlee.sqlite

# Uncomment to use Postgres instead of the SQLite file.
# OWLEE_DATABASE_URL=postgres://owlee:owlee@127.0.0.1:5432/owlee

# Public sign-up stays closed after the setup URL creates the root user.
# The root user opens it in Settings. OWLEE_OPEN_SIGNUP is ignored.
# A mail server (below, or saved in Settings) is required before registration can open.

# Optional email delivery. Without it, email channels are recorded as skipped.
# These variables also count as the mail server for the registration switch.
# OWLEE_SMTP_HOST=smtp.example.com
# OWLEE_SMTP_PORT=587
# OWLEE_SMTP_USERNAME=
# OWLEE_SMTP_PASSWORD=
# OWLEE_SMTP_FROM=status@example.com

# Before a failed connection counts against a monitor, Owlee checks that it can
# reach one of these host:port targets. Use internal hosts if there is no
# internet access, or "off" to turn the check off.
# OWLEE_CONNECTIVITY_TARGETS=1.1.1.1:443,8.8.8.8:443,9.9.9.9:443

# Trusted reverse proxies in front of Owlee. Each hop appends X-Forwarded-For.
# 0 uses the TCP peer and ignores the header, so every visitor behind Traefik
# shares one address and one rate-limit bucket. deploy/compose.yaml sets 1
# for Coolify/Traefik. Use 2 when Cloudflare is in front of that proxy.
# OWLEE_PROXY_HOPS=1
# Optional MaxMind or DB-IP city database for country, region, and city.
# OWLEE_GEOIP_PATH=/var/lib/owlee/dbip-city.mmdb

# Public ingest limits. Defaults are shown. Quotas apply per project and per
# site. OWLEE_*_DAILY_QUOTA is copied once, until the root user saves Settings.
# OWLEE_ERROR_MAX_BODY_BYTES=1048576
# OWLEE_ANALYTICS_MAX_BODY_BYTES=8192
# OWLEE_ERROR_RATE_PROJECT_PER_MIN=120
# OWLEE_ERROR_RATE_PROJECT_BURST=30
# OWLEE_ERROR_RATE_IP_PER_MIN=60
# OWLEE_ERROR_RATE_IP_BURST=20
# OWLEE_ANALYTICS_RATE_SITE_PER_MIN=240
# OWLEE_ANALYTICS_RATE_SITE_BURST=60
# OWLEE_ANALYTICS_RATE_IP_PER_MIN=60
# OWLEE_ANALYTICS_RATE_IP_BURST=30
# OWLEE_LOGIN_RATE_IP_PER_MIN=30
# OWLEE_LOGIN_RATE_IP_BURST=10
# OWLEE_LOGIN_RATE_ACCOUNT_PER_MIN=10
# OWLEE_LOGIN_RATE_ACCOUNT_BURST=5
# OWLEE_ERROR_RETENTION_DAYS=30
# OWLEE_ANALYTICS_RETENTION_DAYS=90
# OWLEE_ERROR_KEEP_FIRST=5
# OWLEE_ERROR_SAMPLE_WINDOW_SECS=3600
# Safety valve, not a bill. 100000 errors is about one per second all day.
# A million analytics events is a large site for a self-hosted install.
# OWLEE_ERROR_DAILY_QUOTA=100000
# OWLEE_ANALYTICS_DAILY_QUOTA=1000000
# Development accepts localhost analytics origins. Production does not.
# OWLEE_INGEST_ALLOW_LOCALHOST=1
# How often verified domains are re-checked, in seconds (minimum 60).
# OWLEE_DOMAIN_RECHECK_SECS=3600
