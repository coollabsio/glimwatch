# Statixo reads STATIXO_* variables. When a STATIXO_* name is unset, HARUVO_* is
# accepted, and STATUS_* is accepted when both of those are unset.
# SQLite is the default. Postgres is selected only when a postgres URL is set.

STATIXO_ENV=development
STATIXO_BIND=127.0.0.1
STATIXO_PORT=43123
STATIXO_PUBLIC_ORIGIN=http://127.0.0.1:43123
STATIXO_DATABASE_PATH=data/statixo.sqlite

# Uncomment to use Postgres instead of the SQLite file.
# HARUVO_DATABASE_URL, STATUS_DATABASE_URL, and DATABASE_URL are also accepted.
# STATIXO_DATABASE_URL=postgres://statixo:statixo@127.0.0.1:5432/statixo

# Public sign-up stays closed after the setup URL creates the root user.
# The root user opens it in Settings. STATIXO_OPEN_SIGNUP, HARUVO_OPEN_SIGNUP,
# and STATUS_OPEN_SIGNUP are ignored.
# A mail server (below, or saved in Settings) is required before registration can open.

# Optional email delivery. Without it, email channels are recorded as skipped.
# These variables also count as the mail server for the registration switch.
# HARUVO_SMTP_* and STATUS_SMTP_* are accepted when STATIXO_SMTP_* is unset.
# STATIXO_SMTP_HOST=smtp.example.com
# STATIXO_SMTP_PORT=587
# STATIXO_SMTP_USERNAME=
# STATIXO_SMTP_PASSWORD=
# STATIXO_SMTP_FROM=status@example.com

# Before a failed connection counts against a monitor, Statixo checks that it can
# reach one of these host:port targets. Use internal hosts if there is no
# internet access, or "off" to turn the check off.
# STATIXO_CONNECTIVITY_TARGETS=1.1.1.1:443,8.8.8.8:443,9.9.9.9:443

# Trusted proxies in front of analytics collection. 2 also trusts Cloudflare geo headers.
# STATIXO_PROXY_HOPS=0
# Optional MaxMind or DB-IP city database for country, region, and city.
# STATIXO_GEOIP_PATH=/var/lib/statixo/dbip-city.mmdb
